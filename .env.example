# Placeholders only. Never commit real credentials.
APP_ENV=development
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/social_publisher

# Use strong secrets injected by a secret manager, never store in repository.
LOGIN_THROTTLE_PEPPER=replace-with-at-least-32-random-characters
SECRETS_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Only required during explicit admin bootstrap, not during normal API runs:
# ADMIN_EMAIL=admin@example.invalid
# ADMIN_PASSWORD=replace-with-a-strong-password

# Production origin must use HTTPS and database transport must verify TLS.
